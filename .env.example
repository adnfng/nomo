# Postgres for analytics. Leave unset locally to use an embedded database in .data/
DATABASE_URL=

# Password for /analytics
ANALYTICS_PASSWORD=
# Secret for signing the /analytics cookie and hashing visitors. Any long random string.
NOMO_SECRET=

# Read-only GitHub token for profile lookups and previews (raises rate limits)
GITHUB_TOKEN=

# GitHub App for "Make it yours"
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Local only: show a .nomo folder at /preview
NOMO_PREVIEW_DIR=

# Vercel sends this as a bearer token to /api/cron/rollup.
CRON_SECRET=
